#!/usr/bin/env python3
"""Harden the GIMP Agent MCP bridge plug-in (gimp-agent-mcp, third party):

1. Its gimp_pdb_call refuses the PDB procedures that run caller-supplied code
   -- the Python and Script-Fu evaluators and consoles, and Script-Fu's
   network server. Agents call named operations, never code (services/
   design-studio README, "Agent capabilities"). The bridge's own Python tool
   is already off (GIMP_AGENT_ALLOW_PYTHON=0); these went around it.
2. A second bridge started while one is alive (e.g. the menu item clicked
   again) says so and exits, instead of taking the next port and rewriting
   the bridge file: clients follow that file, and when the second bridge
   went away they were left pointing at a dead port, the live bridge
   unreachable (2026-10-26).

Each patch is idempotent (its own marker); re-run after any bridge upgrade or
reinstall -- install-gimp-plugins does. Fails loudly if the bridge's code no
longer has the expected shape. GIMP must restart the bridge to load it.
  patch-gimp-agent-bridge [path/to/gimp-agent-bridge.py]"""
import os
import sys

BLOCKED = ("python-fu-eval", "python-fu-console", "plug-in-script-fu-eval", "plug-in-script-fu-console",
           "plug-in-script-fu-text-console", "plug-in-script-fu-server", "extension-script-fu")
IMPORT_ANCHOR = "import agent_bridge_core as core  # noqa: E402\n"
PATCHES = (
    ("# overmind-server: blocked code-running procedures", [
        (IMPORT_ANCHOR, IMPORT_ANCHOR + "\n# overmind-server: blocked code-running procedures (services/design-studio/patch-gimp-agent-bridge)\n"
                        f"OVERMIND_BLOCKED = frozenset({BLOCKED!r})\n"),
        ('    def op_pdb_call(self, params):\n        proc = self._lookup(str(params["name"]))\n',
         '    def op_pdb_call(self, params):\n'
         '        if str(params["name"]).strip().lower() in OVERMIND_BLOCKED:\n'
         '            raise BridgeError(f"{params[\'name\']} runs arbitrary code; blocked for agents (overmind-server)")\n'
         '        proc = self._lookup(str(params["name"]))\n'),
    ]),
    ("# overmind-server: one bridge at a time", [
        ('    token = os.environ.get("GIMP_AGENT_TOKEN") or core.load_or_create_token(path)\n',
         '    token = os.environ.get("GIMP_AGENT_TOKEN") or core.load_or_create_token(path)\n'
         '    # overmind-server: one bridge at a time (services/design-studio/patch-gimp-agent-bridge)\n'
         '    current = core.read_bridge_file(path)\n'
         '    if current and int(current.get("pid", -1)) != os.getpid():\n'
         '        try:\n'
         '            os.kill(int(current["pid"]), 0)\n'
         '            socket.create_connection((core.DEFAULT_HOST, int(current["port"])), timeout=1.0).close()\n'
         '        except (OSError, ValueError, KeyError):\n'
         '            pass                                    # stale: start, and rewrite the file\n'
         '        else:\n'
         '            Gimp.message(f"GIMP Agent Bridge is already running (pid {current[\'pid\']}, port {current[\'port\']}); not starting another.")\n'
         '            return procedure.new_return_values(Gimp.PDBStatusType.SUCCESS, GLib.Error())\n'),
    ]),
)

default = os.path.expanduser("~/Library/Application Support/GIMP/3.2/plug-ins/gimp-agent-bridge/gimp-agent-bridge.py")
path = sys.argv[1] if len(sys.argv) > 1 else default
src = open(path).read()
applied = []
for mark, edits in PATCHES:
    if mark in src:
        continue
    if any(src.count(anchor) != 1 for anchor, _ in edits):
        sys.exit(f"the bridge's code changed shape; not patched ({mark[2:]}): {path}")
    for anchor, replacement in edits:
        src = src.replace(anchor, replacement)
    applied.append(mark[len("# overmind-server: "):])
if not applied:
    print(f"already patched: {path}")
    sys.exit(0)
tmp = path + ".overmind-tmp"
with open(tmp, "w") as f:
    f.write(src)
os.chmod(tmp, os.stat(path).st_mode)
os.replace(tmp, path)
print(f"patched ({', '.join(applied)}): {path}")
