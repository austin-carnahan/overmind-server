#!/usr/bin/env bash
# Link Buckminster's skills into its OpenClaw workspace. Runs as `openclaw`, which owns the workspace
# and the config (it re-runs itself with `sudo -u openclaw` if started as anyone else):
# - its own skills, buckminster/skills/<name>/ in this checkout;
# - the shared GIMP skills, .claude/skills/{gimp,interior-scene-editing}, which Claude Code also reads.
# Each becomes a symlink in <workspace>/skills/, so a `git pull` of this checkout updates them with no
# re-install. OpenClaw only follows workspace skill symlinks into roots listed in
# skills.load.allowSymlinkTargets, so both skill roots are added there (openclaw.json backed up first).
# Third-party skills installed with `npx skills` are copies in the same folder and are left alone.
# Skill changes apply without a Gateway restart. Idempotent.
#
#   bash /opt/overmind/services/design-studio/install-buckminster-skills
set -euo pipefail

repo=$(cd "$(dirname "$0")/../.." && pwd)
own=$repo/services/design-studio/buckminster/skills
shared_root=$repo/.claude/skills
shared=(gimp interior-scene-editing)
ws=/home/openclaw/.openclaw/agents/buckminster/workspace
cfg=/home/openclaw/.openclaw/openclaw.json

[ "$(id -un)" = openclaw ] || exec sudo -u openclaw bash "$repo/services/design-studio/install-buckminster-skills" "$@"
cd ~
[ -d "$ws" ] || { echo "no workspace at $ws" >&2; exit 1; }
oc() { bash -lc "openclaw $*"; }

link() {  # link <skill dir>
    local src=${1%/} dest
    dest=$ws/skills/$(basename "$src")
    [ -f "$src/SKILL.md" ] || { echo "no SKILL.md in $src" >&2; exit 1; }
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        echo "$dest exists and isn't a link; leaving it (remove it to link $src)" >&2
        return
    fi
    ln -sfn "$src" "$dest"
    echo "linked $dest -> $src"
}

mkdir -p "$ws/skills"
for d in "$own"/*/; do link "$d"; done
for s in "${shared[@]}"; do link "$shared_root/$s"; done

echo "== skills.load.allowSymlinkTargets"
current=$(oc config get skills.load.allowSymlinkTargets --json 2>/dev/null | sed -n '/^\[/,$p' || true)
wanted=$(CURRENT="${current:-[]}" python3 - "$own" "$shared_root" <<'EOF'
import json, os, sys
cur = json.loads(os.environ["CURRENT"] or "[]")
new = cur + [p for p in sys.argv[1:] if p not in cur]
print(json.dumps(new) if new != cur else "")
EOF
)
if [ -z "$wanted" ]; then
    echo "already trusts both skill roots"
else
    backup="$cfg.bak-skill-links-$(date +%Y%m%d-%H%M%S)"
    cp -p "$cfg" "$backup" && echo "backup: $backup"
    oc config set skills.load.allowSymlinkTargets "'$wanted'" --strict-json
fi

echo "== Buckminster's skills"
oc skills list --agent buckminster 2>/dev/null | grep -E "openclaw-workspace" || true
