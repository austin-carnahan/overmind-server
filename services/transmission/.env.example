# Copy to .env (ignored by git).

# Config and state (settings.json, resume files): small, low-write-volume,
# alongside the other services' config.
TRANSMISSION_CONFIG_ROOT=/var/lib/overmind/transmission/config

# Bind-mounted from the physical disk (/mnt/disks/<label>/downloads) the same
# way /mnt/substrate and /mnt/library are — see design-notes/storage-layout.md.
# No service ever references /mnt/disks/... directly, including this one.
TRANSMISSION_DOWNLOAD_ROOT=/mnt/downloads

# Matches ROMSETS_INBOX in hosts/overmind-01/paths.env.example
# ($INBOX_ROOT/media/romsets). Lets a per-torrent destination be set
# directly to the real romset staging path in the WebUI, instead of a manual
# copy step after download completes.
TRANSMISSION_ROMSETS_STAGING_ROOT=/var/spool/overmind/media/romsets

# RPC/WebUI login. Both must be set: the linuxserver image turns
# rpc-authentication-required OFF at every start when either is missing, and
# otherwise writes these into settings.json (Transmission hashes the password).
# Keep this file mode 660 once it holds a real password.
USER=CHANGE_ME
PASS=CHANGE_ME
