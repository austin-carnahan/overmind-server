# Copy to .env (ignored by git).

# --- Postgres ---
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=paperclip

# --- Required secrets, no fallback --- generate each with: openssl rand -hex 32
# Session signing.
BETTER_AUTH_SECRET=CHANGE_ME
# Signs tool-action approvals; required, separate from BETTER_AUTH_SECRET.
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=CHANGE_ME

# --- LLM provider auth ---
# Not strictly required to start Paperclip itself, but a runner needs some
# form of model authentication to do anything. Either set a provider API key
# here, or leave both empty and let the runner inherit a supported CLI/
# subscription login instead (e.g. an already-authenticated `claude` CLI).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Reachability ---
# Comma-separated extra hostnames the instance accepts, beyond
# PAPERCLIP_PUBLIC_URL's host. overmind-01 resolves via Tailscale MagicDNS.
PAPERCLIP_ALLOWED_HOSTNAMES=overmind-01
# Set once Tailscale Serve is configured (see README) to the tailnet HTTPS
# endpoint; http://localhost:3100 until then.
PAPERCLIP_PUBLIC_URL=http://localhost:3100
