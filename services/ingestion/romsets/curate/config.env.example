# Copy to config.env (gitignored) and fill in. Never commit real values.

# ScreenScraper: a normal, free ScreenScraper account. Skyscraper (which
# the `scrape` stage shells out to) carries its own registered developer
# credentials, so no separate devid/devpassword is needed here.
SCREENSCRAPER_SSID=
SCREENSCRAPER_SSPASSWORD=

# IGDB auth rides on Twitch OAuth (client-credentials flow) — create a
# Twitch developer application to get these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
