# Copy to .env (ignored by git).

# Config: small, low-write-volume.
ROMARR_CONFIG_ROOT=/var/lib/overmind/romarr/config

# Staging, not the canonical library — Igir remains the actual validation
# gate before anything reaches /mnt/library/romsets. See
# design-notes/overmind_rom_emulator_design_brief.md for why.
ROMARR_STAGING_ROOT=/var/spool/overmind/media/romsets

# Must match services/transmission/.env's TRANSMISSION_DOWNLOAD_ROOT exactly.
# Both containers mount the same host path at the same container path
# (/downloads) so ROMarr can find what Transmission wrote without
# configuring a remote path mapping — same pattern as Radarr/Sonarr.
TRANSMISSION_DOWNLOAD_ROOT=/mnt/ssd/downloads

# Not one of ROMarr's three env-seeded download clients (only qBittorrent,
# SABnzbd, NZBGet are). Transmission is added via Settings -> Download
# Clients in ROMarr's own WebUI: host gluetun, port 9091 — same as
# Radarr/Sonarr, since Transmission has no network identity of its own.

# Required — LIBRARY_KIND defaults to "romm", not "folder". Leaving this
# unset means ROMarr expects a RomM connection we don't have.
LIBRARY_KIND=folder
LIBRARY_PATH=/roms

# Prowlarr connection (its own indexer, not a Prowlarr "Application" entry —
# ROMarr isn't one of Prowlarr's built-in app integrations). Get the API key
# from Prowlarr's Settings -> General -> API Key.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=CHANGE_ME

# A directory holding ONLY No-Intro/Redump DAT files — pointing this at a ROM
# library instead hung ROMarr's startup for ten minutes on the maintainer's
# own install. DAT sourcing itself is still an open decision (where they
# come from, how they stay current) — this just gives ROMarr somewhere to
# look once that's resolved; fine to leave the directory empty for now.
ROMARR_DATS_ROOT=/var/lib/overmind/romarr/dats
DAT_PATH=/dats

PUID=1000
PGID=1000
UMASK=002
