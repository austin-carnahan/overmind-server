# Copy to .env (ignored by git).

# Config/cache: small, low-write-volume, and usable today even without the
# SSD attached.
JELLYFIN_CONFIG_ROOT=/var/lib/overmind/jellyfin/config
JELLYFIN_CACHE_ROOT=/var/lib/overmind/jellyfin/cache

# NOT usable until the SSD is attached and Library is mounted (see
# design-notes/storage-layout.md). Left here so the compose file's shape
# doesn't need to change once these are real.
MOVIES_ROOT=/mnt/library/movies
TV_ROOT=/mnt/library/tv
