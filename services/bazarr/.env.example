# Copy to .env (ignored by git).

# Config: small, low-write-volume, usable today even without the SSD attached.
BAZARR_CONFIG_ROOT=/var/lib/overmind/bazarr/config

# NOT usable until the SSD is attached and Library is mounted (see
# design-notes/storage-layout.md).
MOVIES_ROOT=/mnt/library/movies
TV_ROOT=/mnt/library/tv
