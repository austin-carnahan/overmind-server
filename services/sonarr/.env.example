# Copy to .env (ignored by git).

# Config: small, low-write-volume, usable today even without the SSD attached.
SONARR_CONFIG_ROOT=/var/lib/overmind/sonarr/config

# NOT usable until the SSD is attached and Library is mounted (see
# design-notes/storage-layout.md).
TV_ROOT=/mnt/library/tv

# Must match services/transmission/.env's TRANSMISSION_DOWNLOAD_ROOT exactly.
# Both containers mount the same host path at the same container path
# (/downloads) so Sonarr can find what Transmission wrote without configuring
# a remote path mapping.
TRANSMISSION_DOWNLOAD_ROOT=/home/austin/tmp-downloads
