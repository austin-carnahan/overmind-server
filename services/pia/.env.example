# Copy to .env (ignored by git) and fill in real values on the host.
# Never commit real PIA credentials.
OPENVPN_USER=CHANGE_ME
OPENVPN_PASSWORD=CHANGE_ME

# Comma-separated PIA region name(s), exactly as gluetun's own server list
# names them (verified via `format-servers -private-internet-access`, not
# assumed). Narrow with SERVER_NAMES/SERVER_HOSTNAMES instead if a specific
# server is required. No US PIA region currently supports port forwarding, so
# there's no latency/feature tradeoff in picking the nearest one.
SERVER_REGIONS="US Chicago"
