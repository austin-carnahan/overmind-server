# Copy to .env (ignored by git) and fill in real values on the host.
# Never commit real PIA credentials.
OPENVPN_USER=CHANGE_ME
OPENVPN_PASSWORD=CHANGE_ME

# Comma-separated PIA region name(s). Narrow with SERVER_NAMES/SERVER_HOSTNAMES
# instead if a specific server is required.
SERVER_REGIONS=CA Toronto
