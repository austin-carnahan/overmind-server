#!/usr/bin/env python3
"""Validates models/catalog.yaml and models/variants.yaml together.

Schema (models/schema.json, models/variants.schema.json), then the
cross-references a schema can't express (models/registry.py):
  - unique model ids (incl. previous ids), variant ids and device file names
  - variant stages name existing artifacts with recorded files (sha256)
  - aliases and task selections resolve to selectable, non-rejected variants
  - a task advertised as available selects production variants with serving
  - staged/production variants resolve their whole serving path: supervisor
    slot and profile (compiled in, or cerebrate-profiles.conf), the worker
    config (every device file it names is one of the variant's artifacts and
    vice versa) and, for the endpoint's variant, the MLServer model-settings
  - every validation/benchmark/investigation record exists (file + heading)

Requires: pyyaml, jsonschema (not stdlib -- install into a venv, e.g.:
  python3 -m venv /tmp/catalog-venv && /tmp/catalog-venv/bin/pip install pyyaml jsonschema
  /tmp/catalog-venv/bin/python3 scripts/validate-model-catalog

Exit 0: valid. Exit 1: invalid, or a file is missing/malformed.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "models"))
import registry  # noqa: E402


def main() -> int:
    try:
        reg = registry.Registry.load()
    except (OSError, ValueError) as exc:
        print(f"error: could not read the registry: {exc}", file=sys.stderr)
        return 1
    errors = reg.validate()
    if errors:
        for e in errors:
            print(f"error: {e}", file=sys.stderr)
        return 1
    n_var = len(reg.variants.get("variants", {}))
    print(f"OK: models/catalog.yaml + models/variants.yaml are valid "
          f"({len(reg.models)} model(s), {n_var} variant(s), {len(reg.tasks)} task(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
