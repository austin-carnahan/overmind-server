#!/usr/bin/env python3
"""Stages one or all models from models/catalog.yaml onto cerebrate-pixel6.

Implements catalog v4 Section 7.4: read a catalog entry, locate the
already-verified artifact in the local cache (models/README.md), adb-push
it to a temp path on the device, verify the remote checksum, then
atomically rename it into place. Idempotent: if the device already has a
file at the target path with a matching checksum, the push is skipped.

Deliberately targets the flat /data/local/tmp/<filename> layout already in
production use by cerebrate-infer/cerebrate-generate today, not catalog
v4's illustrative /data/local/tmp/cerebrate/models/... subdirectory -- this
stage makes the existing, working layout reproducible, and does not migrate
it (that would also mean changing both workers' launch commands).

Requires: pyyaml (not stdlib -- install into a venv, e.g.:
  python3 -m venv /tmp/stage-model-venv && /tmp/stage-model-venv/bin/pip install pyyaml
  /tmp/stage-model-venv/bin/python3 scripts/stage-model <model-key>

Usage:
  scripts/stage-model <model-key>   # stage one model's artifacts
  scripts/stage-model --all         # stage every model in the catalog

Exit 0: everything requested is staged and verified.
Exit 1: a lookup, push, or checksum verification failed.
"""
import hashlib
import subprocess
import sys
from pathlib import Path

import yaml

REPO_ROOT = Path(__file__).resolve().parent.parent
CATALOG_PATH = REPO_ROOT / "models" / "catalog.yaml"
HF_HOME = Path("/mnt/models/huggingface")
DIRECT_CACHE = Path("/mnt/models/direct")
ADB_SERIAL = "192.168.68.60:5555"
REMOTE_DIR = "/data/local/tmp"


def adb(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["adb", "-s", ADB_SERIAL, *args],
        capture_output=True, text=True, check=True,
    )


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def hf_cache_dir(repo: str, revision: str) -> Path:
    org, name = repo.split("/", 1)
    return HF_HOME / "hub" / f"models--{org}--{name}" / "snapshots" / revision


def resolve_local_artifact(artifact_type: str, source: dict, model_key: str) -> Path:
    """Find the single cached file for this artifact, matching its type's extension."""
    if "repo" in source:
        cache_dir = hf_cache_dir(source["repo"], source["revision"])
    elif "url" in source:
        cache_dir = DIRECT_CACHE / model_key
    else:
        raise ValueError(f"unrecognized source shape: {source!r}")

    if not cache_dir.is_dir():
        raise FileNotFoundError(
            f"cache dir not found: {cache_dir} -- run the fetch step in "
            f"models/README.md first"
        )

    candidates = [
        p for p in cache_dir.iterdir()
        if p.is_file() and p.suffix.lstrip(".") == artifact_type
    ]
    if len(candidates) != 1:
        raise FileNotFoundError(
            f"expected exactly one *.{artifact_type} file in {cache_dir}, "
            f"found {len(candidates)}: {[p.name for p in candidates]}"
        )
    return candidates[0]


def remote_sha256(remote_path: str) -> str | None:
    result = adb("shell", f"sha256sum {remote_path} 2>/dev/null")
    line = result.stdout.strip()
    if not line:
        return None
    return line.split()[0]


def stage_artifact(model_key: str, artifact_type: str, source: dict) -> None:
    local_path = resolve_local_artifact(artifact_type, source, model_key)
    local_hash = sha256_of(local_path)
    remote_final = f"{REMOTE_DIR}/{local_path.name}"

    existing_hash = remote_sha256(remote_final)
    if existing_hash == local_hash:
        print(f"  [{model_key}/{artifact_type}] already staged, checksum matches -- skipping push")
        return

    remote_temp = f"{REMOTE_DIR}/.staging-{local_path.name}"
    print(f"  [{model_key}/{artifact_type}] pushing {local_path.name} ({local_path.stat().st_size} bytes)...")
    adb("push", str(local_path), remote_temp)

    pushed_hash = remote_sha256(remote_temp)
    if pushed_hash != local_hash:
        adb("shell", f"rm -f {remote_temp}")
        raise RuntimeError(
            f"checksum mismatch after push: local={local_hash} remote={pushed_hash} "
            f"-- left {remote_temp} removed, {remote_final} untouched"
        )

    adb("shell", f"mv -f {remote_temp} {remote_final}")
    print(f"  [{model_key}/{artifact_type}] staged and verified: {remote_final}")


def stage_model(catalog: dict, model_key: str) -> None:
    model = catalog["models"][model_key]
    print(f"{model_key}:")
    for artifact_type, artifact in model["artifacts"].items():
        stage_artifact(model_key, artifact_type, artifact["source"])


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__, file=sys.stderr)
        return 1

    with open(CATALOG_PATH) as f:
        catalog = yaml.safe_load(f)

    try:
        adb("get-state")
    except subprocess.CalledProcessError as exc:
        print(f"error: adb device {ADB_SERIAL} not reachable: {exc.stderr.strip()}", file=sys.stderr)
        return 1

    target = sys.argv[1]
    keys = list(catalog["models"]) if target == "--all" else [target]
    for key in keys:
        if key not in catalog["models"]:
            print(f"error: no such model in catalog: {key}", file=sys.stderr)
            return 1

    try:
        for key in keys:
            stage_model(catalog, key)
    except (FileNotFoundError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
