#!/usr/bin/env python3
"""Stages one or all models from models/catalog.yaml onto cerebrate-pixel6.

Implements catalog v4 Section 7.4: for each file a catalog artifact records
(`files`: name, sha256, bytes), locate the verified copy in the artifact
store (models/README.md: the Hugging Face cache for published files,
derived/<model>/ for our conversions, direct/<model>/ for plain downloads),
check its sha256 against the catalog, adb-push it to a temp path on the
device, verify the remote checksum, then atomically rename it into place at
/data/local/tmp/<name> -- the flat layout cerebrate-supervisor approves.
Idempotent: a file already on the device with the recorded checksum is
skipped. Files for the guest (`target: guest`) are not pushed.

Requires: pyyaml + jsonschema (the registry's venv, models/README.md).

Usage:
  scripts/stage-model <model-key>... [--dry-run]   stage these models' files
  scripts/stage-model --all [--dry-run]            every model in the catalog

Exit 0: everything requested is staged and verified (or, --dry-run, would be).
Exit 1: a lookup, checksum, or push failed.
"""
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "models"))
import registry  # noqa: E402

ADB_SERIAL = "192.168.68.60:5555"
REMOTE_DIR = registry.DEVICE_DIR


def adb(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["adb", "-s", ADB_SERIAL, *args], capture_output=True, text=True, check=True)


def remote_sha256(remote_path: str):
    """None when the file isn't there (sha256sum then exits non-zero)."""
    result = subprocess.run(["adb", "-s", ADB_SERIAL, "shell", f"sha256sum {remote_path} 2>/dev/null"], capture_output=True, text=True)
    line = result.stdout.strip()
    return line.split()[0] if result.returncode == 0 and line else None


def stage_file(reg, model, akey, f, dry_run):
    local = reg.store_path(model, akey, f)
    remote_final = f"{REMOTE_DIR}/{f['name']}"
    if remote_sha256(remote_final) == f["sha256"]:
        print(f"  [{model}/{akey}] {f['name']}: already staged, checksum matches")
        return
    if not local.exists():
        raise FileNotFoundError(f"{local} not in the artifact store -- fetch it first (models/README.md)")
    local_hash = registry.sha256_file(local)
    if local_hash != f["sha256"]:
        raise RuntimeError(f"{local}: sha256 {local_hash} != catalog {f['sha256']} -- refusing to stage")
    if dry_run:
        print(f"  [{model}/{akey}] {f['name']}: would push {local} ({f['bytes']} bytes)")
        return
    remote_temp = f"{REMOTE_DIR}/.staging-{f['name']}"
    print(f"  [{model}/{akey}] pushing {f['name']} ({f['bytes']} bytes)...")
    adb("push", str(local), remote_temp)
    pushed = remote_sha256(remote_temp)
    if pushed != f["sha256"]:
        adb("shell", f"rm -f {remote_temp}")
        raise RuntimeError(f"checksum mismatch after push: {pushed} != {f['sha256']} -- {remote_final} untouched")
    adb("shell", f"mv -f {remote_temp} {remote_final}")
    print(f"  [{model}/{akey}] staged and verified: {remote_final}")


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--dry-run"]
    dry_run = "--dry-run" in sys.argv[1:]
    if not args:
        print(__doc__, file=sys.stderr)
        return 1
    reg = registry.Registry.load()
    keys = list(reg.models) if args == ["--all"] else [reg.canonical_model(k) or k for k in args]
    for key in keys:
        if key not in reg.models:
            print(f"error: no such model in catalog: {key}", file=sys.stderr)
            return 1
    try:
        adb("get-state")
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        print(f"error: adb device {ADB_SERIAL} not reachable: {exc}", file=sys.stderr)
        return 1
    try:
        for key in keys:
            print(f"{key}:")
            for model, akey, f in reg.artifact_files(key):
                if reg.models[model]["artifacts"][akey].get("target") == "guest":
                    continue
                stage_file(reg, model, akey, f, dry_run)
    except (FileNotFoundError, RuntimeError, subprocess.CalledProcessError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
