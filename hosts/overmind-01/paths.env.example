# Logical paths only. No automatic loading or directory creation.
# Copy to paths.env for local notes if needed; *.env is ignored.
OVERMIND_ROOT=/opt/overmind
SUBSTRATE_ROOT=/mnt/substrate
LIBRARY_ROOT=/mnt/library
INBOX_ROOT=/var/spool/overmind
DOCUMENT_INBOX=$INBOX_ROOT/documents
AGENT_NOTE_INBOX=$DOCUMENT_INBOX/agent-notes

# Media inbox: one subfolder per type so ingestion can route on arrival path.
# Pending review/quarantine is a state within these folders, not a separate
# root (see services/ingestion/quarantine).
MEDIA_INBOX=$INBOX_ROOT/media
MOVIES_INBOX=$MEDIA_INBOX/movies
TV_INBOX=$MEDIA_INBOX/tv
ROMSETS_INBOX=$MEDIA_INBOX/romsets
MUSIC_INBOX=$MEDIA_INBOX/music # when needed

# Transmission's incomplete/in-progress download state is its own working
# directory, not a logical Overmind path (see services/transmission). Only
# completed, seeding-safe downloads become ordinary arrivals under the
# matching *_INBOX above.

MOVIES_ROOT=$LIBRARY_ROOT/movies
TV_ROOT=$LIBRARY_ROOT/tv
MUSIC_ROOT=$LIBRARY_ROOT/music # when needed
# Two tiers (see AGENTS.md rule 3): ROMSET_ARCHIVE_ROOT is DAT-verified,
# broadly-curated (1G1R, language/region filtered), kept indefinitely, not
# exposed to any client. ROMSET_LIBRARY_ROOT is further curated down to a
# small browsable set -- the only tier exposed to SMB/R-Shop/clients.
ROMSET_ARCHIVE_ROOT=$LIBRARY_ROOT/romsets-archive
ROMSET_LIBRARY_ROOT=$LIBRARY_ROOT/romsets
# Provisional: live saves stay at emulator defaults; Library may hold exports.
# Exact save paths/export workflow await emulator/client choice and user preference.
# Service state/cache: each service's defaults, documented per service.
# Physical device identity, mounts, and users/groups: TBD.
